@if (SyncService.IsSyncing)
{
    <div class="flex items-center gap-2 text-blue-600">
        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-sm">Synchronisiere...</span>
    </div>
}
else if (HasPendingSyncs)
{
    <button @onclick="HandleSync" class="btn-primary text-sm">
        Sync (@PendingCount)
    </button>
}

@implements IDisposable

@code {
    [Inject] public ISyncService SyncService { get; set; } = null!;
    
    private bool HasPendingSyncs { get; set; }
    private int PendingCount { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CheckPendingSyncs();
        SyncService.SyncCompleted += OnSyncCompleted;
        SyncService.SyncError += OnSyncError;
    }

    private async Task CheckPendingSyncs()
    {
        HasPendingSyncs = await SyncService.HasPendingSyncsAsync();
        // TODO: Get actual count
        PendingCount = HasPendingSyncs ? 1 : 0;
        StateHasChanged();
    }

    private async void OnSyncCompleted(object? sender, EventArgs e)
    {
        await CheckPendingSyncs();
    }

    private async void OnSyncError(object? sender, string error)
    {
        await CheckPendingSyncs();
    }

    private async Task HandleSync()
    {
        await SyncService.SyncAsync();
        await CheckPendingSyncs();
    }

    public void Dispose()
    {
        SyncService.SyncCompleted -= OnSyncCompleted;
        SyncService.SyncError -= OnSyncError;
    }
}
