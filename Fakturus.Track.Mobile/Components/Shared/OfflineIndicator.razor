@if (!NetworkMonitor.IsConnected)
{
    <div class="ios-offline-banner">
        <span class="ios-offline-text">Offline Mode - Daten werden lokal gespeichert</span>
    </div>
}

<style>
    .ios-offline-banner {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: #FF9500;
        color: white;
        text-align: center;
        padding: 0.5rem;
        z-index: 1000;
        font-size: 13px;
        font-weight: 500;
        padding-top: calc(env(safe-area-inset-top, 0px) + 0.5rem);
    }

    .ios-offline-text {
        display: block;
    }
</style>

@implements IDisposable

@code {
    [Inject] public INetworkMonitor NetworkMonitor { get; set; } = null!;

    protected override void OnInitialized()
    {
        NetworkMonitor.ConnectivityChanged += OnConnectivityChanged;
    }

    private void OnConnectivityChanged(object? sender, bool isConnected)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NetworkMonitor.ConnectivityChanged -= OnConnectivityChanged;
    }

}