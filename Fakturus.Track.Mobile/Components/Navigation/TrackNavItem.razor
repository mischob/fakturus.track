@* iOS-style tab bar item *@

<NavLink href="@Href" class="@GetCssClasses()">
    <div class="ios-tab-item-content">
        @if (Icon == "clock")
        {
            <svg class="ios-tab-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        }
        else if (Icon == "sun")
        {
            <svg class="ios-tab-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
        }
        else if (Icon == "chart")
        {
            <svg class="ios-tab-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
        }
        else if (Icon == "settings")
        {
            <svg class="ios-tab-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
        }
        <span class="ios-tab-label">@Label</span>
    </div>
</NavLink>

<style>
    .ios-tab-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 49px;
        min-height: 44px;
        min-width: 44px;
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
        transition: opacity 0.2s;
    }

    .ios-tab-item:active {
        opacity: 0.6;
    }

    .ios-tab-item-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
    }

    .ios-tab-icon {
        width: 22px;
        height: 22px;
        stroke-width: 2;
    }

    .ios-tab-label {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    /* Inactive state */
    .ios-tab-item:not(.active) {
        color: #8E8E93;
    }

    .ios-tab-item:not(.active) .ios-tab-icon {
        color: #8E8E93;
    }

    .ios-tab-item:not(.active) .ios-tab-label {
        color: #8E8E93;
    }

    /* Active state - iOS blue */
    .ios-tab-item.active.ios-tab-blue,
    .ios-tab-item.active.ios-tab-blue .ios-tab-icon,
    .ios-tab-item.active.ios-tab-blue .ios-tab-label {
        color: #007AFF;
    }

    /* Active state - iOS green */
    .ios-tab-item.active.ios-tab-green,
    .ios-tab-item.active.ios-tab-green .ios-tab-icon,
    .ios-tab-item.active.ios-tab-green .ios-tab-label {
        color: #34C759;
    }

    /* Active state - iOS orange */
    .ios-tab-item.active.ios-tab-orange,
    .ios-tab-item.active.ios-tab-orange .ios-tab-icon,
    .ios-tab-item.active.ios-tab-orange .ios-tab-label {
        color: #FF9500;
    }

    /* Active state - iOS gray */
    .ios-tab-item.active.ios-tab-gray,
    .ios-tab-item.active.ios-tab-gray .ios-tab-icon,
    .ios-tab-item.active.ios-tab-gray .ios-tab-label {
        color: #000000;
    }
</style>

@code {
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Color { get; set; } = "gray";
    [Parameter] public bool IsActive { get; set; }

    private string GetCssClasses()
    {
        var classes = "ios-tab-item";
        if (IsActive)
        {
            classes += " active ios-tab-" + Color;
        }
        return classes;
    }
}
