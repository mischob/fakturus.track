@page "/gesamt"
@using Microsoft.Extensions.Logging
@inject ISettingsApiClient SettingsApiClient
@inject IToastService ToastService
@inject ILogger<Gesamt> Logger

<PageTitle>Gesamt - Fakturus Track</PageTitle>

<div class="ios-page">
    <div class="ios-page-header">
        <h1 class="ios-page-title">Gesamt</h1>
    </div>

    <div class="ios-page-content">
        @if (_isLoading)
        {
            <div class="ios-card text-center">
                <p class="ios-text-secondary">Lade Übersicht...</p>
            </div>
        }
        else if (_summary != null)
        {
            <!-- Summary Cards -->
            <div class="summary-cards">
                <OvertimeCard
                    Title="Gesamt Überstunden"
                    Value="@FormatHours(_summary.TotalOvertimeHours)"
                    Subtitle="@GetOvertimeSubtitleWithSchoolHolidays(_summary)"
                    IconColor="@(_summary.TotalOvertimeHours >= 0 ? "text-green-600" : "text-red-600")"
                    ValueColor="@(_summary.TotalOvertimeHours >= 0 ? "text-green-600" : "text-red-600")"/>

                <OvertimeCard
                    Title="Urlaub"
                    Value="@($"{_summary.VacationDaysTaken} / {_summary.VacationDaysPerYear}")"
                    Subtitle="@($"{_summary.VacationDaysRemaining} Tage übrig")"
                    IconColor="text-blue-600"
                    ValueColor="text-gray-900"/>

                <OvertimeCard
                    Title="Feiertage"
                    Value="@_summary.HolidaysTaken.ToString()"
                    Subtitle="@($"Feiertage in {_selectedYear}")"
                    IconColor="text-purple-600"
                    ValueColor="text-gray-900"/>
            </div>

            <!-- Year Selector -->
            <div class="ios-card year-selector-card">
                <div class="year-selector">
                    <h2 class="ios-text-primary year-selector-title">Monatliche Übersicht</h2>
                    <div class="year-selector-controls">
                        <button @onclick="PreviousYear" class="btn-year-nav">
                            ← @(_selectedYear - 1)
                        </button>
                        <span class="year-display">@_selectedYear</span>
                        <button @onclick="NextYear" class="btn-year-nav">
                            @(_selectedYear + 1) →
                        </button>
                    </div>
                </div>
            </div>

            <!-- Monthly Breakdown -->
            <div class="ios-card table-card">
                <div class="table-wrapper">
                    <table class="overtime-table">
                        <thead>
                        <tr>
                            <th class="table-header table-header-month">Monat</th>
                            <th class="table-header table-header-right">Gearbeitet</th>
                            <th class="table-header table-header-right">Erwartet</th>
                            <th class="table-header table-header-right">Überstunden</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var month in _summary.MonthlyOvertime)
                        {
                            <tr class="table-row">
                                <td class="table-cell table-cell-month">@GetShortMonthName(month.MonthName)</td>
                                <td class="table-cell table-cell-right">@FormatHours(month.WorkedHours)</td>
                                <td class="table-cell table-cell-right">@FormatHours(month.ExpectedHours)</td>
                                <td class="table-cell table-cell-right table-cell-overtime @(month.OvertimeHours >= 0 ? "text-green-600" : "text-red-600")">
                                    @FormatHours(month.OvertimeHours)
                                </td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                        <tr class="table-footer">
                            <td class="table-cell table-cell-month table-footer-cell">Gesamt</td>
                            <td class="table-cell table-cell-right table-footer-cell">@FormatHours(_summary.MonthlyOvertime.Sum(m => m.WorkedHours))</td>
                            <td class="table-cell table-cell-right table-footer-cell">@FormatHours(_summary.MonthlyOvertime.Sum(m => m.ExpectedHours))</td>
                            <td class="table-cell table-cell-right table-footer-cell @(_summary.TotalOvertimeHours >= 0 ? "text-green-600" : "text-red-600")">
                                @FormatHours(_summary.TotalOvertimeHours)
                            </td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="ios-card text-center">
                <p class="ios-text-secondary">Keine Daten verfügbar</p>
            </div>
        }
    </div>
</div>

<style>
    .ios-page {
        min-height: 100%;
        background-color: #f2f2f7;
        display: flex;
        flex-direction: column;
    }

    .ios-page-header {
        background-color: white;
        padding: 1rem;
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        border-bottom: 0.5px solid rgba(0, 0, 0, 0.1);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .ios-page-title {
        font-size: 34px;
        font-weight: 700;
        color: #000000;
        margin: 0;
        letter-spacing: 0.37px;
    }

    .ios-page-content {
        flex: 1;
        padding: 1rem;
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .ios-card {
        background-color: white;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .ios-text-primary {
        font-size: 17px;
        color: #000000;
        margin: 0;
    }

    .ios-text-secondary {
        font-size: 17px;
        color: #000000;
        margin: 0 0 0.5rem 0;
    }

    .ios-text-tertiary {
        font-size: 15px;
        color: #8E8E93;
        margin: 0;
    }

    .text-center {
        text-align: center;
    }

    .text-green-600 {
        color: #34C759;
    }

    .text-red-600 {
        color: #FF3B30;
    }

    .text-blue-600 {
        color: #007AFF;
    }

    .text-purple-600 {
        color: #AF52DE;
    }

    .text-gray-900 {
        color: #000000;
    }

    /* Summary Cards */
    .summary-cards {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    /* Year Selector */
    .year-selector-card {
        margin-bottom: 1rem;
    }

    .year-selector {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .year-selector-title {
        font-size: 20px;
        font-weight: 600;
        margin: 0;
    }

    .year-selector-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .btn-year-nav {
        background-color: #f2f2f7;
        color: #007AFF;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-year-nav:active {
        background-color: #e5e5ea;
    }

    .year-display {
        font-size: 17px;
        font-weight: 600;
        color: #000000;
        padding: 0 1rem;
    }

    /* Table */
    .table-card {
        margin-bottom: 1rem;
        padding: 0;
        overflow: hidden;
    }

    .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .overtime-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 15px;
    }

    .table-header {
        font-weight: 600;
        color: #000000;
        padding: 0.75rem 0.5rem;
        text-align: left;
        border-bottom: 0.5px solid rgba(0, 0, 0, 0.1);
        background-color: #f9f9f9;
    }

    .table-header-right {
        text-align: right;
    }

    .table-header-month {
        width: 80px;
    }

    .table-row {
        border-bottom: 0.5px solid rgba(0, 0, 0, 0.05);
    }

    .table-row:last-child {
        border-bottom: none;
    }

    .table-cell {
        padding: 0.75rem 0.5rem;
        color: #000000;
    }

    .table-cell-right {
        text-align: right;
    }

    .table-cell-month {
        font-weight: 500;
    }

    .table-cell-overtime {
        font-weight: 600;
    }

    .table-footer {
        border-top: 2px solid rgba(0, 0, 0, 0.2);
        background-color: #f9f9f9;
    }

    .table-footer-cell {
        font-weight: 700;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }
</style>

@code {
    private OvertimeSummaryModel? _summary;
    private int _selectedYear = DateTime.Now.Year;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            Logger.LogDebug("[UI] [Gesamt] Loading summary for year {Year}", _selectedYear);
            _summary = await SettingsApiClient.GetOvertimeSummaryAsync(_selectedYear);
            Logger.LogDebug("[UI] [Gesamt] Summary loaded successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Gesamt] Error loading summary");
            ToastService.ShowError($"Fehler beim Laden der Übersicht: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PreviousYear()
    {
        _selectedYear--;
        await LoadSummaryAsync();
    }

    private async Task NextYear()
    {
        _selectedYear++;
        await LoadSummaryAsync();
    }

    private string FormatHours(decimal hours)
    {
        var sign = hours < 0 ? "-" : "";
        var absHours = Math.Abs(hours);
        var wholeHours = (int)absHours;
        var minutes = (int)((absHours - wholeHours) * 60);
        return $"{sign}{wholeHours:D2}:{minutes:D2}h";
    }

    private string GetOvertimeSubtitle(decimal hours)
    {
        if (hours > 0)
            return "Mehr gearbeitet als erwartet";
        if (hours < 0)
            return "Weniger gearbeitet als erwartet";
        return "Genau wie erwartet gearbeitet";
    }

    private string GetOvertimeSubtitleWithSchoolHolidays(OvertimeSummaryModel summary)
    {
        var baseText = GetOvertimeSubtitle(summary.TotalOvertimeHours);
        if (summary.SchoolHolidayHoursNotWorked > 0)
        {
            return $"{baseText} (davon {FormatHours(summary.SchoolHolidayHoursNotWorked)} in Schulferien)";
        }

        return baseText;
    }

    private string GetShortMonthName(string fullMonthName)
    {
        return fullMonthName switch
        {
            "Januar" => "Jan",
            "Februar" => "Feb",
            "März" => "Mär",
            "April" => "Apr",
            "Mai" => "Mai",
            "Juni" => "Jun",
            "Juli" => "Jul",
            "August" => "Aug",
            "September" => "Sep",
            "Oktober" => "Okt",
            "November" => "Nov",
            "Dezember" => "Dez",
            _ => fullMonthName
        };
    }

}