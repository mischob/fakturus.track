@page "/"
@page "/zeiten"
@using Fakturus.Track.Mobile.Data
@implements IDisposable
@inject MobileDbContext Db
@inject ISyncService SyncService
@inject IOfflineAuthService AuthService
@inject IToastService ToastService
@inject IWorkSessionsApiClient ApiClient
@inject ILogger<Zeiten> Logger

<PageTitle>Zeiten - Fakturus Track</PageTitle>

<div class="ios-page">
    <div class="ios-page-header">
        <div class="zeiten-header">
            <h1 class="ios-page-title">Zeiten</h1>
            <div class="zeiten-header-actions">
                @if (!_isAuthenticated)
                {
                    <span class="ios-badge ios-badge-yellow">Nicht angemeldet</span>
                }
                <button @onclick="HandleSync"
                        class="btn-primary zeiten-sync-btn @(_isSyncing ? "syncing" : "") @(!_isAuthenticated ? "needs-login" : "")"
                        disabled="@_isSyncing">
                    @if (_isSyncing)
                    {
                        <span>Syncing...</span>
                    }
                    else if (!_isAuthenticated)
                    {
                        <span>Anmelden & Sync</span>
                    }
                    else
                    {
                        <span>Sync</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="ios-page-content">
        <!-- Current Session Card -->
        @if (_currentSession != null)
        {
            <WorkSessionCard WorkSession="_currentSession"
                             OnStart="HandleStart"
                             OnStop="HandleStop"
                             OnFinish="HandleFinish"
                             OnSave="HandleSave"
                             OnDelete="HandleDelete"
                             OnCancel="HandleCancel"
                             OnNew="HandleNew"
                             OnTimeChanged="HandleTimeChanged"/>
        }
        else
        {
            <div class="ios-card">
                <div class="zeiten-empty-state">
                    <p class="ios-text-secondary">Starte einen neuen Eintrag!</p>
                    <button @onclick="HandleNew" class="btn-primary zeiten-new-btn">
                        Neuer Eintrag
                    </button>
                </div>
            </div>
        }

        <!-- History -->
        <div class="zeiten-history">
            <h2 class="ios-text-primary zeiten-history-title">History</h2>
            @if (_monthGroups.Any())
            {
                @foreach (var group in _monthGroups)
                {
                    <MonthGroupCard MonthGroup="group"
                                    OnToggle="HandleToggleGroup"
                                    OnStart="HandleStart"
                                    OnStop="HandleStop"
                                    OnFinish="HandleFinish"
                                    OnSave="HandleSave"
                                    OnDelete="HandleDelete"
                                    OnCancel="HandleCancel"
                                    OnNew="HandleNew"
                                    OnTimeChanged="HandleTimeChanged"/>
                }
            }
            else
            {
                <div class="ios-card">
                    <p class="ios-text-secondary text-center">Keine Einträge soweit</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .ios-page {
        min-height: 100%;
        background-color: #f2f2f7;
        display: flex;
        flex-direction: column;
    }

    .ios-page-header {
        background-color: white;
        padding: 1rem;
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        border-bottom: 0.5px solid rgba(0, 0, 0, 0.1);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .ios-page-title {
        font-size: 34px;
        font-weight: 700;
        color: #000000;
        margin: 0;
        letter-spacing: 0.37px;
    }

    .ios-page-content {
        flex: 1;
        padding: 1rem;
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .zeiten-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .zeiten-header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .zeiten-sync-btn {
        font-size: 15px;
        padding: 0.5rem 1rem;
    }

    .zeiten-sync-btn.syncing {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .zeiten-sync-btn.needs-login {
        opacity: 0.8;
    }

    .ios-badge {
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
    }

    .ios-badge-yellow {
        background-color: #FF9500;
        color: white;
    }

    .zeiten-empty-state {
        text-align: center;
        padding: 2rem 0;
    }

    .zeiten-new-btn {
        margin-top: 1rem;
        padding: 0.75rem 1.5rem;
    }

    .zeiten-history {
        margin-top: 1.5rem;
    }

    .zeiten-history-title {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .text-center {
        text-align: center;
    }
</style>

@code {
    private List<WorkSessionModel> _workSessions = [];
    private List<MonthGroup> _monthGroups = [];
    private WorkSessionModel? _currentSession;
    private bool _isSyncing;
    private bool _isFinishing; // Flag to prevent re-loading finished session
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("[UI] [Zeiten] OnInitializedAsync - START");

        // Check authentication status
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        Logger.LogInformation("[UI] [Zeiten] Authentication status: {IsAuthenticated}", _isAuthenticated);

        // Subscribe to authentication state changes
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;

        // Subscribe to sync completed event
        SyncService.SyncCompleted += OnSyncCompleted;

        await LoadWorkSessionsAsync();

        // Perform initial sync
        try
        {
            await SyncService.SyncAsync();
            await LoadWorkSessionsAsync();
        }
        catch (Exception ex)
        {
            // Silently fail on initialization - user can manually sync
            Logger.LogWarning(ex, "[UI] [Zeiten] Initial sync failed: {Message}", ex.Message);
        }

        // Start background sync if there are pending sessions
        try
        {
            await SyncService.StartPeriodicSyncAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[UI] [Zeiten] Failed to start background sync: {Message}", ex.Message);
        }

        Logger.LogInformation("[UI] [Zeiten] OnInitializedAsync - END");
    }

    private void OnAuthenticationStateChanged(object? sender, bool isAuthenticated)
    {
        _isAuthenticated = isAuthenticated;
        Logger.LogInformation("[UI] [Zeiten] Authentication state changed: {IsAuthenticated}", isAuthenticated);
        InvokeAsync(StateHasChanged);
    }

    private async void OnSyncCompleted(object? sender, EventArgs e)
    {
        Logger.LogInformation("[UI] [Zeiten] Sync completed, reloading sessions...");
        await InvokeAsync(async () =>
        {
            await LoadWorkSessionsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        // Unsubscribe from authentication state changes
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;

        // Unsubscribe from sync completed event
        SyncService.SyncCompleted -= OnSyncCompleted;

        // Stop background sync when component is disposed
        SyncService.StopPeriodicSync();
    }

    private async Task LoadWorkSessionsAsync()
    {
        try
        {
            var userId = await AuthService.GetUserIdOrAnonymousAsync();
            if (string.IsNullOrEmpty(userId))
            {
                Logger.LogWarning("[UI] [Zeiten] No userId available, cannot load sessions");
                _workSessions = [];
                _monthGroups = [];
                StateHasChanged();
                return;
            }

            var entities = await Db.WorkSessions
                .AsNoTracking()
                .Where(ws => ws.UserId == userId)
                .OrderByDescending(ws => ws.Date)
                .ThenByDescending(ws => ws.StartTime)
                .ToListAsync();
            _workSessions = entities.ToModels();
            Logger.LogInformation("[UI] [Zeiten] LoadWorkSessionsAsync: Loaded {Count} sessions from database", _workSessions.Count);

            // If we're finishing a session, don't reload it as current
            if (_isFinishing)
            {
                _isFinishing = false;
                _currentSession = null;
                GroupSessionsByMonth();
                StateHasChanged();
                return;
            }

            // Current session logic: Only local unfinished sessions can be current
            if (_currentSession != null)
            {
                // Try to find the same session by ID first
                var existingCurrent = _workSessions.FirstOrDefault(s => s.Id == _currentSession.Id);
                if (existingCurrent != null)
                {
                    // Keep as current only if it's not finished yet
                    if (!existingCurrent.IsFinished)
                    {
                        _currentSession = existingCurrent;
                        Logger.LogDebug("[UI] [Zeiten] Kept existing current session {SessionId}", _currentSession.Id);
                    }
                    else
                    {
                        // Session was finished, move to history
                        _currentSession = null;
                        Logger.LogDebug("[UI] [Zeiten] Current session was finished, moved to history");
                    }
                }
                else
                {
                    // Session not found (maybe deleted), clear current session
                    _currentSession = null;
                    Logger.LogDebug("[UI] [Zeiten] Current session not found, cleared");
                }
            }

            // Group sessions by month
            GroupSessionsByMonth();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error loading work sessions");
            ToastService.ShowError($"Fehler beim Laden der Zeiten: {ex.Message}");
        }
    }

    private void GroupSessionsByMonth()
    {
        // Get history sessions (exclude current session and unfinished sessions)
        var historySessions = _workSessions
            .Where(s => s.IsFinished) // Only show finished sessions in history
            .Where(s => _currentSession == null || s.Id != _currentSession.Id)
            .ToList();

        // Store current expanded state before regrouping
        var expandedMonths = _monthGroups
            .Where(g => g.IsExpanded)
            .Select(g => (g.Year, g.Month))
            .ToHashSet();

        // Group by Year and Month
        _monthGroups = historySessions
            .GroupBy(s => new { s.Date.Year, s.Date.Month })
            .Select(g => new MonthGroup
            {
                Year = g.Key.Year,
                Month = g.Key.Month,
                MonthName = GetGermanMonthName(g.Key.Month),
                Sessions = g.OrderByDescending(s => s.Date)
                    .ThenByDescending(s => s.StartTime != default ? s.StartTime : DateTime.MinValue)
                    .ToList(),
                TotalEntries = g.Count(),
                CompletedEntries = g.Count(s => s.StartTime != default && s.StopTime.HasValue),
                TotalDuration = TimeSpan.FromTicks(g
                    .Where(s => s.StartTime != default && s.StopTime.HasValue)
                    .Sum(s => CalculateDuration(s).Ticks)),
                IsExpanded = expandedMonths.Contains((g.Key.Year, g.Key.Month))
            })
            .OrderByDescending(g => g.Year)
            .ThenByDescending(g => g.Month)
            .ToList();
    }

    private string GetGermanMonthName(int month)
    {
        return month switch
        {
            1 => "Januar",
            2 => "Februar",
            3 => "März",
            4 => "April",
            5 => "Mai",
            6 => "Juni",
            7 => "Juli",
            8 => "August",
            9 => "September",
            10 => "Oktober",
            11 => "November",
            12 => "Dezember",
            _ => ""
        };
    }

    private void HandleToggleGroup(MonthGroup group)
    {
        group.IsExpanded = !group.IsExpanded;
        StateHasChanged();
    }

    private TimeSpan CalculateDuration(WorkSessionModel session)
    {
        if (session.StartTime == default || !session.StopTime.HasValue)
            return TimeSpan.Zero;
        return session.StopTime.Value - session.StartTime;
    }

    private async Task HandleStart(WorkSessionModel session)
    {
        try
        {
            session.StartTime = DateTime.UtcNow;
            session.Date = DateOnly.FromDateTime(DateTime.Now);
            session.IsFinished = false; // Keep as unfinished (still in progress)
            session.IsPendingSync = true;
            session.IsSynced = false; // Mark as not synced
            session.UpdatedAt = DateTime.UtcNow;

            var userId = await AuthService.GetUserIdOrAnonymousAsync();
            session.UserId = userId;

            var entity = await Db.WorkSessions.FindAsync(session.Id);
            if (entity != null)
            {
                entity.StartTime = session.StartTime;
                entity.Date = session.Date;
                entity.IsFinished = session.IsFinished;
                entity.IsPendingSync = session.IsPendingSync;
                entity.IsSynced = session.IsSynced;
                entity.UpdatedAt = session.UpdatedAt;
                entity.UserId = session.UserId;
                await Db.SaveChangesAsync();
            }
            else
            {
                entity = session.ToEntity();
                await Db.WorkSessions.AddAsync(entity);
                await Db.SaveChangesAsync();
            }

            await LoadWorkSessionsAsync();

            ToastService.ShowSuccess("Start time recorded");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleStart");
            ToastService.ShowError($"Fehler beim Speichern: {ex.Message}");
        }
    }

    private async Task HandleStop(WorkSessionModel session)
    {
        try
        {
            // Set stop time but don't close the session
            session.StopTime = DateTime.UtcNow;
            session.IsFinished = false; // Keep as unfinished (session stopped but not finished)
            session.IsPendingSync = true;
            session.IsSynced = false; // Mark as not synced
            session.UpdatedAt = DateTime.UtcNow;

            var entity = await Db.WorkSessions.FindAsync(session.Id);
            if (entity != null)
            {
                entity.StopTime = session.StopTime;
                entity.IsFinished = session.IsFinished;
                entity.IsPendingSync = session.IsPendingSync;
                entity.IsSynced = session.IsSynced;
                entity.UpdatedAt = session.UpdatedAt;
                await Db.SaveChangesAsync();
            }

            await LoadWorkSessionsAsync();

            ToastService.ShowSuccess("Stop time recorded");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleStop");
            ToastService.ShowError($"Fehler beim Speichern: {ex.Message}");
        }
    }

    private async Task HandleFinish(WorkSessionModel session)
    {
        try
        {
            // Finish closes the session and moves it to history
            // Ensure StopTime is set
            session.StopTime ??= DateTime.UtcNow;

            session.IsFinished = true; // Mark as finished for sync
            session.IsPendingSync = true;
            session.IsSynced = false; // Mark as not synced
            session.UpdatedAt = DateTime.UtcNow;

            var entity = await Db.WorkSessions.FindAsync(session.Id);
            if (entity != null)
            {
                entity.StopTime = session.StopTime;
                entity.IsFinished = session.IsFinished;
                entity.IsPendingSync = session.IsPendingSync;
                entity.IsSynced = session.IsSynced;
                entity.UpdatedAt = session.UpdatedAt;
                await Db.SaveChangesAsync();
            }

            _isFinishing = true;

            await LoadWorkSessionsAsync();

            await SyncService.StartPeriodicSyncAsync();

            ToastService.ShowSuccess("Session finished");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleFinish");
            ToastService.ShowError($"Fehler beim Speichern: {ex.Message}");
        }
    }

    private async Task HandleNew()
    {
        try
        {
            var userId = await AuthService.GetUserIdOrAnonymousAsync();
            var newSession = new WorkSessionModel
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Date = DateOnly.FromDateTime(DateTime.Now),
                StartTime = default, // Don't set start time initially - let user set it
                StopTime = null,
                IsFinished = false, // Initialize as unfinished (new session)
                IsPendingSync = true,
                IsSynced = false,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            var entity = newSession.ToEntity();
            Db.ChangeTracker.Clear();
            await Db.WorkSessions.AddAsync(entity);
            await Db.SaveChangesAsync();
            _currentSession = newSession;
            await LoadWorkSessionsAsync();

            ToastService.ShowSuccess("New session created");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleNew");
            ToastService.ShowError($"Fehler beim Erstellen: {ex.Message}");
        }
    }

    private async Task HandleCancel(WorkSessionModel session)
    {
        try
        {
            // Just exit edit mode / clear current session without deleting
            // For history items: WorkSessionCard handles exiting edit mode internally
            // For current session: Clear it from current view
            if (_currentSession?.Id == session.Id)
            {
                _currentSession = null;
            }

            // Reload to refresh the view
            await LoadWorkSessionsAsync();
            ToastService.ShowInfo("Cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleCancel");
            ToastService.ShowError($"Fehler: {ex.Message}");
        }
    }

    private async Task HandleSave(WorkSessionModel session)
    {
        try
        {
            session.IsFinished = true; // Mark as finished for sync
            session.IsPendingSync = true;
            session.IsSynced = false; // Mark as not synced so it will be included in next sync
            session.UpdatedAt = DateTime.UtcNow;

            var entity = await Db.WorkSessions.FindAsync(session.Id);
            if (entity != null)
            {
                entity.Date = session.Date;
                entity.StartTime = session.StartTime;
                entity.StopTime = session.StopTime;
                entity.IsFinished = session.IsFinished;
                entity.IsPendingSync = session.IsPendingSync;
                entity.IsSynced = session.IsSynced;
                entity.UpdatedAt = session.UpdatedAt;
                await Db.SaveChangesAsync();
            }

            await LoadWorkSessionsAsync();

            // Start background sync for the saved session
            await SyncService.StartPeriodicSyncAsync();

            ToastService.ShowSuccess("Session saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleSave");
            ToastService.ShowError($"Fehler beim Speichern: {ex.Message}");
        }
    }

    private async Task HandleTimeChanged(WorkSessionModel session)
    {
        try
        {
            // Save time changes for current session without marking as finished
            // This keeps the session as current and doesn't trigger sync
            session.IsFinished = false; // Keep as unfinished
            session.IsPendingSync = true;
            session.IsSynced = false;
            session.UpdatedAt = DateTime.UtcNow;

            var entity = await Db.WorkSessions.FindAsync(session.Id);
            if (entity != null)
            {
                entity.Date = session.Date;
                entity.StartTime = session.StartTime;
                entity.StopTime = session.StopTime;
                entity.IsFinished = session.IsFinished;
                entity.IsPendingSync = session.IsPendingSync;
                entity.IsSynced = session.IsSynced;
                entity.UpdatedAt = session.UpdatedAt;
                await Db.SaveChangesAsync();
            }

            await LoadWorkSessionsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleTimeChanged");
            // Silent fail for time changes
        }
    }

    private async Task HandleDelete(WorkSessionModel session)
    {
        try
        {
            // Always try to delete from backend if session exists there (synced or has SyncedAt)
            if (session.IsSynced || session.SyncedAt.HasValue)
            {
                try
                {
                    await ApiClient.DeleteWorkSessionAsync(session.Id);
                    ToastService.ShowSuccess("Session deleted from server");
                }
                catch (Exception ex)
                {
                    // If backend delete fails, still delete locally but show warning
                    Logger.LogWarning(ex, "[UI] [Zeiten] Backend delete failed for session {SessionId}", session.Id);
                    ToastService.ShowWarning($"Session deleted locally, but server deletion failed: {ex.Message}");
                }
            }
            else
            {
                // Session was never synced, just delete locally
                ToastService.ShowSuccess("Session deleted");
            }

            var entity = await Db.WorkSessions.FindAsync(session.Id);
            if (entity != null)
            {
                Db.WorkSessions.Remove(entity);
                await Db.SaveChangesAsync();
            }

            await LoadWorkSessionsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleDelete");
            ToastService.ShowError($"Failed to delete session: {ex.Message}");
        }
    }

    private async Task HandleSync()
    {
        if (_isSyncing) return;

        // Check authentication first
        if (!_isAuthenticated)
        {
            var wasAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!wasAuthenticated)
            {
                ToastService.ShowInfo("Bitte melden Sie sich an, um zu synchronisieren");
                try
                {
                    Logger.LogInformation("[UI] [Zeiten] User not authenticated, starting login process");
                    var loginSuccess = await AuthService.LoginAsync();
                    if (loginSuccess)
                    {
                        _isAuthenticated = true;
                        Logger.LogInformation("[UI] [Zeiten] Login successful, continuing with sync");
                        ToastService.ShowSuccess("Erfolgreich angemeldet");
                        // Continue with sync after successful login
                    }
                    else
                    {
                        Logger.LogWarning("[UI] [Zeiten] Login failed");
                        ToastService.ShowError("Anmeldung fehlgeschlagen");
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[UI] [Zeiten] Error during login");
                    ToastService.ShowError($"Anmeldung fehlgeschlagen: {ex.Message}");
                    return;
                }
            }
            else
            {
                _isAuthenticated = true;
                Logger.LogInformation("[UI] [Zeiten] Authentication status updated, user is authenticated");
            }
        }

        _isSyncing = true;
        StateHasChanged(); // Update UI to show syncing state

        try
        {
            await SyncService.SyncAsync();
            // After sync, reload sessions
            // LoadWorkSessionsAsync will preserve the current session by ID if it exists
            await LoadWorkSessionsAsync();

            // Restart background sync if there are still pending sessions
            await SyncService.StartPeriodicSyncAsync();

            StateHasChanged(); // Force UI refresh after sync
            ToastService.ShowSuccess("Sync completed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[UI] [Zeiten] Error in HandleSync");
            ToastService.ShowError($"Sync failed: {ex.Message}");
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged(); // Update UI to hide syncing state
        }
    }

}