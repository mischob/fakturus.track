@inject ILogger<Routes> Logger
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(MauiProgram).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        @{
            Logger.LogInformation("[Router] Route found - Path: {Path}, Page: {PageType}",
                Navigation.Uri, routeData.PageType?.Name ?? "Unknown");
        }
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
        @{
            Logger.LogWarning("[Router] Route not found - Path: {Path}", Navigation.Uri);
        }
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {

    private Task OnNavigateAsync(NavigationContext context)
    {
        Logger.LogInformation("[Router] Navigating to: {Path}", context.Path);
        return Task.CompletedTask;
    }

}