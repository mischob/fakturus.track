@page "/einstellungen"
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Einstellungen - fakturus.track</PageTitle>

<h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Einstellungen</h1>

@if (isLoading)
{
    <div class="flex items-center justify-center py-12">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
    </div>
}
else
{
    <div class="space-y-6 max-w-2xl">
        <!-- Arbeitszeit -->
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Arbeitszeit</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Wochenstunden</label>
                    <input type="number" step="0.5" min="1" max="60" @bind="settings.WorkHoursPerWeek"
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Arbeitstage</label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var (label, bit) in workDayOptions)
                        {
                            var isChecked = (settings.WorkDays & (1 << bit)) != 0;
                            <label class="inline-flex items-center gap-2 px-3 py-2 border rounded-lg cursor-pointer transition-colors
                                          @(isChecked ? "bg-primary-50 dark:bg-primary-900/30 border-primary-300 dark:border-primary-700 text-primary-700 dark:text-primary-300" : "border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800")">
                                <input type="checkbox" checked="@isChecked" @onchange="(e) => ToggleWorkDay(bit, (bool)(e.Value ?? false))"
                                       class="sr-only" />
                                <span class="text-sm font-medium">@label</span>
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Bundesland</label>
                    <select @bind="settings.Bundesland"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                        <option value="BW">Baden-Wuerttemberg</option>
                        <option value="BY">Bayern</option>
                        <option value="BE">Berlin</option>
                        <option value="BB">Brandenburg</option>
                        <option value="HB">Bremen</option>
                        <option value="HH">Hamburg</option>
                        <option value="HE">Hessen</option>
                        <option value="MV">Mecklenburg-Vorpommern</option>
                        <option value="NI">Niedersachsen</option>
                        <option value="NW">Nordrhein-Westfalen</option>
                        <option value="RP">Rheinland-Pfalz</option>
                        <option value="SL">Saarland</option>
                        <option value="SN">Sachsen</option>
                        <option value="ST">Sachsen-Anhalt</option>
                        <option value="SH">Schleswig-Holstein</option>
                        <option value="TH">Thueringen</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Urlaub -->
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Urlaub</h2>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Urlaubstage pro Jahr</label>
                <input type="number" min="0" max="60" @bind="settings.VacationDaysPerYear"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
            </div>
        </div>

        <!-- Schulferien -->
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Schulferien</h2>
                <button @onclick="OpenAddSchoolHoliday"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Hinzufuegen
                </button>
            </div>
            @if (schoolHolidays.Count == 0)
            {
                <p class="text-sm text-gray-500 dark:text-gray-400 py-4 text-center">Keine Schulferien eingetragen.</p>
            }
            else
            {
                <div class="divide-y divide-gray-100 dark:divide-gray-800">
                    @foreach (var period in schoolHolidays.OrderBy(p => p.StartDate))
                    {
                        <div class="flex items-center justify-between py-3">
                            <div>
                                <p class="text-sm font-medium text-gray-900 dark:text-white">@period.Name</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">@period.StartDate.ToString("dd.MM.yyyy") - @period.EndDate.ToString("dd.MM.yyyy")</p>
                            </div>
                            <div class="flex gap-1">
                                <button @onclick="() => OpenEditSchoolHoliday(period)"
                                        class="p-1.5 text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <button @onclick="() => ConfirmDeleteSchoolHoliday(period.Id)"
                                        class="p-1.5 text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Save -->
        <div class="flex items-center gap-3">
            <button @onclick="SaveSettings"
                    disabled="@isSaving"
                    class="px-6 py-2.5 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white font-medium rounded-lg transition-colors">
                @if (isSaving)
                {
                    <span class="inline-flex items-center gap-2">
                        <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                        Speichern...
                    </span>
                }
                else
                {
                    <span>Speichern</span>
                }
            </button>
            @if (showSaved)
            {
                <span class="text-sm text-green-600 dark:text-green-400">Gespeichert</span>
            }
        </div>

        <!-- Rechtliches -->
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Rechtliches</h2>
            <div class="space-y-2">
                <a href="/privacy" target="_blank"
                   class="flex items-center justify-between py-2 text-sm text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                    Datenschutzerklaerung
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </a>
                <a href="/terms" target="_blank"
                   class="flex items-center justify-between py-2 text-sm text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                    Allgemeine Geschaeftsbedingungen
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </a>
                <a href="/imprint" target="_blank"
                   class="flex items-center justify-between py-2 text-sm text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                    Impressum
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Konto -->
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Konto</h2>
            <div class="space-y-3">
                <a href="/account/logout"
                   class="block w-full px-4 py-2.5 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors text-center">
                    Abmelden
                </a>
                <button @onclick="() => showDeleteDialog = true"
                        class="w-full px-4 py-2.5 border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 font-medium rounded-lg text-sm hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                    Konto loeschen
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Account Dialog -->
@if (showDeleteDialog)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl max-w-md w-full p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 bg-red-100 dark:bg-red-900/30 rounded-lg">
                    <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Konto loeschen</h3>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
                Sind Sie sicher, dass Sie Ihr Konto loeschen moechten? Alle Daten werden unwiderruflich geloescht. Dieser Vorgang kann nicht rueckgaengig gemacht werden.
            </p>
            <div class="flex gap-3 justify-end">
                <button @onclick="() => showDeleteDialog = false"
                        class="px-4 py-2 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    Abbrechen
                </button>
                <button @onclick="DeleteAccount"
                        class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg text-sm transition-colors">
                    Endgueltig loeschen
                </button>
            </div>
        </div>
    </div>
}

<!-- School Holiday Add/Edit Dialog -->
@if (showSchoolHolidayDialog)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl max-w-md w-full p-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
                @(isEditingSchoolHoliday ? "Schulferien bearbeiten" : "Schulferien hinzufuegen")
            </h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
                    <input type="text" @bind="schoolHolidayName" placeholder="z.B. Sommerferien 2026"
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Von</label>
                        <input type="date" @bind="schoolHolidayStartDate"
                               class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Bis</label>
                        <input type="date" @bind="schoolHolidayEndDate"
                               class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    </div>
                </div>
            </div>
            <div class="flex gap-3 justify-end mt-6">
                <button @onclick="() => showSchoolHolidayDialog = false"
                        class="px-4 py-2 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    Abbrechen
                </button>
                <button @onclick="SaveSchoolHolidayAsync"
                        disabled="@(string.IsNullOrWhiteSpace(schoolHolidayName))"
                        class="px-4 py-2 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white font-medium rounded-lg text-sm transition-colors">
                    Speichern
                </button>
            </div>
        </div>
    </div>
}

<!-- School Holiday Delete Dialog -->
@if (showDeleteSchoolHolidayDialog)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl max-w-md w-full p-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Schulferien loeschen</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
                Moechten Sie diesen Ferienzeitraum wirklich loeschen?
            </p>
            <div class="flex gap-3 justify-end">
                <button @onclick="() => showDeleteSchoolHolidayDialog = false"
                        class="px-4 py-2 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    Abbrechen
                </button>
                <button @onclick="DeleteSchoolHolidayAsync"
                        class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg text-sm transition-colors">
                    Loeschen
                </button>
            </div>
        </div>
    </div>
}

@code {
    private UserSettings settings = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool showSaved;
    private bool showDeleteDialog;

    // School holidays
    private List<SchoolHolidayPeriod> schoolHolidays = new();
    private bool showSchoolHolidayDialog;
    private bool isEditingSchoolHoliday;
    private Guid editingSchoolHolidayId;
    private string schoolHolidayName = string.Empty;
    private DateOnly schoolHolidayStartDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly schoolHolidayEndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
    private bool showDeleteSchoolHolidayDialog;
    private Guid deletingSchoolHolidayId;

    private readonly (string Label, int Bit)[] workDayOptions = new[]
    {
        ("Mo", 0), ("Di", 1), ("Mi", 2), ("Do", 3), ("Fr", 4), ("Sa", 5), ("So", 6)
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await Api.GetUserSettingsAsync();
            schoolHolidays = await Api.GetSchoolHolidayPeriodsAsync();
        }
        catch
        {
            settings = new();
            schoolHolidays = new();
        }
        isLoading = false;
    }

    private void ToggleWorkDay(int bit, bool isChecked)
    {
        if (isChecked)
            settings.WorkDays |= (1 << bit);
        else
            settings.WorkDays &= ~(1 << bit);
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        showSaved = false;
        try
        {
            await Api.SaveUserSettingsAsync(settings);
            showSaved = true;
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                showSaved = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            // Handle error
        }
        isSaving = false;
    }

    private async Task DeleteAccount()
    {
        try
        {
            await Api.DeleteAccountAsync();
            Navigation.NavigateTo("/account/logout", forceLoad: true);
        }
        catch
        {
            showDeleteDialog = false;
        }
    }

    // School holiday methods
    private void OpenAddSchoolHoliday()
    {
        isEditingSchoolHoliday = false;
        schoolHolidayName = string.Empty;
        schoolHolidayStartDate = DateOnly.FromDateTime(DateTime.Today);
        schoolHolidayEndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
        showSchoolHolidayDialog = true;
    }

    private void OpenEditSchoolHoliday(SchoolHolidayPeriod period)
    {
        isEditingSchoolHoliday = true;
        editingSchoolHolidayId = period.Id;
        schoolHolidayName = period.Name;
        schoolHolidayStartDate = period.StartDate;
        schoolHolidayEndDate = period.EndDate;
        showSchoolHolidayDialog = true;
    }

    private async Task SaveSchoolHolidayAsync()
    {
        try
        {
            if (isEditingSchoolHoliday)
            {
                await Api.UpdateSchoolHolidayPeriodAsync(editingSchoolHolidayId, new UpdateSchoolHolidayPeriodRequest
                {
                    Name = schoolHolidayName,
                    StartDate = schoolHolidayStartDate,
                    EndDate = schoolHolidayEndDate
                });
            }
            else
            {
                await Api.CreateSchoolHolidayPeriodAsync(new CreateSchoolHolidayPeriodRequest
                {
                    Name = schoolHolidayName,
                    StartDate = schoolHolidayStartDate,
                    EndDate = schoolHolidayEndDate
                });
            }
            schoolHolidays = await Api.GetSchoolHolidayPeriodsAsync();
        }
        catch
        {
            // Handle error silently for now
        }
        showSchoolHolidayDialog = false;
    }

    private void ConfirmDeleteSchoolHoliday(Guid id)
    {
        deletingSchoolHolidayId = id;
        showDeleteSchoolHolidayDialog = true;
    }

    private async Task DeleteSchoolHolidayAsync()
    {
        try
        {
            await Api.DeleteSchoolHolidayPeriodAsync(deletingSchoolHolidayId);
            schoolHolidays = await Api.GetSchoolHolidayPeriodsAsync();
        }
        catch
        {
            // Handle error silently for now
        }
        showDeleteSchoolHolidayDialog = false;
    }
}
