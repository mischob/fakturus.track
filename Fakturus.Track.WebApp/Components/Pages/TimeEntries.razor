@page "/zeiten"
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>Zeiten - fakturus.track</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Zeiten</h1>
    <div class="flex items-center gap-2">
        <button @onclick="PreviousMonth"
                class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 min-w-[120px] text-center">
            @currentDate.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))
        </span>
        <button @onclick="NextMonth"
                class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>
    </div>
</div>

<!-- Monthly Groups -->
@foreach (var group in groupedSessions)
{
    <div class="mb-6">
        <button @onclick="() => ToggleGroup(group.Key)"
                class="w-full flex items-center justify-between px-4 py-3 bg-gray-100 dark:bg-gray-800 rounded-t-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
            <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">
                @group.Key
            </span>
            <div class="flex items-center gap-3">
                <span class="text-xs text-gray-500 dark:text-gray-400">@group.Value.Count Eintraege</span>
                <svg class="w-4 h-4 text-gray-500 transition-transform @(IsGroupCollapsed(group.Key) ? "" : "rotate-180")"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>
        </button>

        @if (!IsGroupCollapsed(group.Key))
        {
            <div class="bg-white dark:bg-gray-900 rounded-b-xl shadow-sm border border-gray-200 dark:border-gray-800 border-t-0 overflow-hidden">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Datum</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Tag</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Start</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Ende</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Pause</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Netto</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                        @foreach (var session in group.Value)
                        {
                            <tr @onclick="() => SelectSession(session)"
                                class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer @(selectedSession?.Id == session.Id ? "bg-primary-50 dark:bg-primary-900/20" : "")">
                                <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-100">@session.Date.ToString("dd.MM.")</td>
                                <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400">
                                    @session.Date.ToDateTime(TimeOnly.MinValue).ToString("ddd", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))
                                </td>
                                <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400">@session.StartTime.ToLocalTime().ToString("HH:mm")</td>
                                <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400">
                                    @(session.StopTime?.ToLocalTime().ToString("HH:mm") ?? "--:--")
                                </td>
                                <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400">--</td>
                                <td class="px-6 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">
                                    @if (session.StopTime.HasValue)
                                    {
                                        var net = session.StopTime.Value - session.StartTime;
                                        @($"{(int)net.TotalHours:D2}:{net.Minutes:D2}")
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">--:--</span>
                                    }
                                </td>
                                <td class="px-6 py-3 text-sm">
                                    @if (session.IsSynced)
                                    {
                                        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                        </svg>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (!groupedSessions.Any())
{
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-12 text-center">
        <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-gray-500 dark:text-gray-400">Keine Zeiteintraege fuer diesen Monat</p>
    </div>
}

<!-- Side Panel for editing -->
@if (selectedSession != null)
{
    <div class="fixed inset-y-0 right-0 w-96 bg-white dark:bg-gray-900 shadow-2xl border-l border-gray-200 dark:border-gray-800 z-40 overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Eintrag bearbeiten</h3>
            <button @onclick="() => selectedSession = null"
                    class="p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Datum</label>
                <input type="date" value="@selectedSession.Date.ToString("yyyy-MM-dd")"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Startzeit</label>
                <input type="time" value="@selectedSession.StartTime.ToLocalTime().ToString("HH:mm")"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Endzeit</label>
                <input type="time" value="@(selectedSession.StopTime?.ToLocalTime().ToString("HH:mm") ?? "")"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
            </div>
            <div class="pt-4 flex gap-3">
                <button class="flex-1 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-lg text-sm transition-colors">
                    Speichern
                </button>
                <button @onclick="() => selectedSession = null"
                        class="px-4 py-2 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    Abbrechen
                </button>
            </div>
        </div>
    </div>
}

@code {
    private DateTime currentDate = DateTime.Now;
    private List<WorkSession> sessions = new();
    private Dictionary<string, List<WorkSession>> groupedSessions = new();
    private HashSet<string> collapsedGroups = new();
    private WorkSession? selectedSession;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        try
        {
            sessions = await Api.GetWorkSessionsByMonthAsync(currentDate.Year, currentDate.Month);
        }
        catch
        {
            sessions = new();
        }

        groupedSessions = sessions
            .OrderByDescending(s => s.Date)
            .GroupBy(s => $"KW {System.Globalization.ISOWeek.GetWeekOfYear(s.Date.ToDateTime(TimeOnly.MinValue))}")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task PreviousMonth()
    {
        currentDate = currentDate.AddMonths(-1);
        await LoadSessions();
    }

    private async Task NextMonth()
    {
        currentDate = currentDate.AddMonths(1);
        await LoadSessions();
    }

    private void ToggleGroup(string key)
    {
        if (!collapsedGroups.Remove(key))
        {
            collapsedGroups.Add(key);
        }
    }

    private bool IsGroupCollapsed(string key) => collapsedGroups.Contains(key);

    private void SelectSession(WorkSession session)
    {
        selectedSession = selectedSession?.Id == session.Id ? null : session;
    }
}
