@page "/reports"
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Reports - fakturus.track</PageTitle>

<h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Reports</h1>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">Gesamte Ueberstunden @selectedYear</p>
        <p class="text-3xl font-bold mt-1 @(summary.TotalOvertimeHours >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
            @(summary.TotalOvertimeHours >= 0 ? "+" : "")@summary.TotalOvertimeHours.ToString("F1") h
        </p>
    </div>
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">Urlaubssaldo @selectedYear</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-white mt-1">
            @summary.VacationDaysRemaining <span class="text-base font-normal text-gray-500">/ @summary.VacationDaysPerYear Tage</span>
        </p>
    </div>
</div>

<!-- Year selector + Export -->
<div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
        <button @onclick="PreviousYear"
                class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        <span class="text-lg font-semibold text-gray-900 dark:text-white min-w-[60px] text-center">@selectedYear</span>
        <button @onclick="NextYear"
                class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>
    </div>

    <div class="flex items-center gap-2">
        <div class="relative">
            <button @onclick="() => showExportMenu = !showExportMenu"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Exportieren
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>
            @if (showExportMenu)
            {
                <!-- Backdrop to close menu on outside click -->
                <div class="fixed inset-0 z-0" @onclick="() => showExportMenu = false"></div>
                <div class="absolute right-0 mt-2 w-56 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg z-10 py-1">
                    <button @onclick="@(() => Export("csv", "month"))" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">CSV - Monat</button>
                    <button @onclick="@(() => Export("csv", "quarter"))" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">CSV - Quartal</button>
                    <button @onclick="@(() => Export("csv", "year"))" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">CSV - Jahr</button>
                    <hr class="my-1 border-gray-200 dark:border-gray-700" />
                    <button @onclick="@(() => Export("pdf", "month"))" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">PDF - Monat</button>
                    <button @onclick="@(() => Export("pdf", "year"))" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">PDF - Jahr</button>
                    <hr class="my-1 border-gray-200 dark:border-gray-700" />
                    <button @onclick="@(() => Export("datev", "month"))" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">DATEV Export (Monat)</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Overtime Table -->
<div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden">
    <table class="w-full">
        <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50">
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Monat</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Soll (h)</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Ist (h)</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Differenz</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Kumuliert</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            @{
                decimal cumulative = 0;
            }
            @foreach (var month in summary.MonthlyOvertime.OrderBy(m => m.Month))
            {
                cumulative += month.OvertimeHours;
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                    <td class="px-6 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">@month.MonthName</td>
                    <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400 text-right">@month.ExpectedHours.ToString("F1")</td>
                    <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400 text-right">@month.WorkedHours.ToString("F1")</td>
                    <td class="px-6 py-3 text-sm font-medium text-right @(month.OvertimeHours >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                        @(month.OvertimeHours >= 0 ? "+" : "")@month.OvertimeHours.ToString("F1")
                    </td>
                    <td class="px-6 py-3 text-sm font-medium text-right @(cumulative >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                        @(cumulative >= 0 ? "+" : "")@cumulative.ToString("F1")
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="border-t-2 border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50">
                <td class="px-6 py-3 text-sm font-bold text-gray-900 dark:text-white">Gesamt</td>
                <td class="px-6 py-3 text-sm font-bold text-gray-900 dark:text-white text-right">
                    @summary.MonthlyOvertime.Sum(m => m.ExpectedHours).ToString("F1")
                </td>
                <td class="px-6 py-3 text-sm font-bold text-gray-900 dark:text-white text-right">
                    @summary.MonthlyOvertime.Sum(m => m.WorkedHours).ToString("F1")
                </td>
                <td class="px-6 py-3 text-sm font-bold text-right @(summary.TotalOvertimeHours >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                    @(summary.TotalOvertimeHours >= 0 ? "+" : "")@summary.TotalOvertimeHours.ToString("F1")
                </td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    private int selectedYear = DateTime.Now.Year;
    private OvertimeSummary summary = new();
    private bool showExportMenu;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            summary = await Api.GetOvertimeSummaryAsync(selectedYear);
        }
        catch
        {
            summary = new();
        }
    }

    private async Task PreviousYear()
    {
        selectedYear--;
        await LoadData();
    }

    private async Task NextYear()
    {
        selectedYear++;
        await LoadData();
    }

    private void Export(string format, string period)
    {
        showExportMenu = false;
        var currentMonth = DateTime.Now.Month;
        var currentQuarter = (currentMonth - 1) / 3 + 1;
        Navigation.NavigateTo(
            $"api/reports/export?format={format}&period={period}&year={selectedYear}&month={currentMonth}&quarter={currentQuarter}",
            forceLoad: true);
    }
}
