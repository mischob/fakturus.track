@inherits LayoutComponentBase
@inject ConsentService ConsentService
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-60 bg-gray-900 text-white flex flex-col fixed inset-y-0 left-0 z-30">
        <!-- Logo -->
        <div class="px-6 py-5 border-b border-gray-800">
            <a href="/" class="text-xl font-bold tracking-tight text-white hover:text-primary-400 transition-colors">
                fakturus<span class="text-primary-400">.track</span>
            </a>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <NavLink href="" Match="NavLinkMatch.All"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
                     ActiveClass="bg-primary-600 text-white hover:bg-primary-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                Dashboard
            </NavLink>

            <NavLink href="zeiten"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
                     ActiveClass="bg-primary-600 text-white hover:bg-primary-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Zeiten
            </NavLink>

            <NavLink href="urlaub"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
                     ActiveClass="bg-primary-600 text-white hover:bg-primary-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Urlaub
            </NavLink>

            <NavLink href="reports"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
                     ActiveClass="bg-primary-600 text-white hover:bg-primary-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Reports
            </NavLink>

            <NavLink href="einstellungen"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
                     ActiveClass="bg-primary-600 text-white hover:bg-primary-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Einstellungen
            </NavLink>
        </nav>

        <!-- User section -->
        <div class="px-3 py-4 border-t border-gray-800">
            <AuthorizeView>
                <Authorized>
                    <div class="flex items-center gap-3 px-3 py-2">
                        <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center text-sm font-bold text-white">
                            @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-white truncate">@context.User.Identity?.Name</p>
                        </div>
                    </div>
                    <form method="post" action="MicrosoftIdentity/Account/SignOut" class="mt-2">
                        <AntiforgeryToken />
                        <button type="submit"
                                class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Abmelden
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-60 flex-1 min-h-screen">
        @if (!ConsentService.HasRequiredConsents && ConsentService.IsLoaded)
        {
            <Fakturus.Track.WebApp.Components.Pages.Consent />
        }
        else
        {
            <div class="max-w-7xl mx-auto px-6 py-8">
                @Body
            </div>
        }
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 right-0 bg-yellow-50 border-t border-yellow-200 px-4 py-3 text-yellow-800 text-sm z-50 hidden">
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="underline font-medium ml-2">Neu laden</a>
    <span class="dismiss cursor-pointer absolute right-3 top-2">&#x2715;</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ConsentService.LoadConsentStatusAsync();
    }
}
